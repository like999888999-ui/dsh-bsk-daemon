{
  "name": "dsh-bsk-daemon",
  "version": "0.1.1",
  "description": "Keep the BrowserSkill bsk daemon available on demand inside DeepSeek Harness. Fixes the Windows 'os error 5' that stops the daemon from starting at all, by owning it with a scheduled task and a wake shim.",
  "type": "module",
  "license": "MIT",
  "author": "like999888999-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/like999888999-ui/dsh-bsk-daemon.git"
  },
  "homepage": "https://github.com/like999888999-ui/dsh-bsk-daemon#readme",
  "bugs": {
    "url": "https://github.com/like999888999-ui/dsh-bsk-daemon/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/platform.js",
    "lib/schema-fallback.js",
    "lib/shim/BskShim.cs",
    "lib/shim/build-shim.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "browserskill",
    "bsk",
    "browser-automation"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/platform.js",
    "test": "npm run check && node --test \"test/*.test.mjs\""
  }
}
